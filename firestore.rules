rules_version = '2';

// Regles de Firestore d'Evolt (TR01.1, docs/api.md §8.13).
//
// Ningú no pot llegir ni escriure res des de fora: només el backend parla amb
// Firestore, amb el compte de servei, i el compte de servei no passa per
// aquestes regles. El frontend no fa servir Firebase.
//
// Es despleguen amb:  firebase deploy --only firestore:rules
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
